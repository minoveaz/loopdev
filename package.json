{
  "name": "loopdev-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "start:loopdev": "node scripts/dev/start-loopdev.mjs",
    "start:loopdev:local": "node scripts/dev/start-loopdev.mjs --with-supabase",
    "start:loopdev:full": "node scripts/dev/start-loopdev.mjs --with-supabase",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:shell": "node scripts/check-shell.mjs",
    "test:shell:changed": "node scripts/check-shell.mjs --changed-only",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "e2e:preflight": "node scripts/e2e/preflight.mjs",
    "e2e:crm:quick": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/crm-primitives.certification.spec.mjs --project=desktop --workers=1",
    "e2e:crm:matrix": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/crm-primitives.certification.spec.mjs --project=desktop --project=mobile --project=mobile-compact --workers=1",
    "e2e:entity-table:smoke": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/entity-table.certification.spec.mjs --project=desktop --grep smoke --workers=1",
    "e2e:entity-table:desktop": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/entity-table.certification.spec.mjs --project=desktop --workers=1",
    "e2e:entity-table:matrix": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/entity-table.certification.spec.mjs --project=desktop --project=mobile --project=mobile-compact --workers=1",
    "e2e:entity-table:golden": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/entity-table-golden.visual.spec.mjs --project=desktop --project=mobile --project=mobile-compact --workers=1",
    "e2e:dense-operational-table:matrix": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/dense-operational-table.visual.spec.mjs --project=desktop --project=mobile --project=mobile-compact --workers=1",
    "e2e:command-dialog": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test e2e/command-dialog.certification.spec.mjs --project=desktop --project=mobile --project=mobile-compact --workers=1",
    "e2e:full": "PLAYWRIGHT_E2E_AUTH_BYPASS=true NEXT_PUBLIC_E2E_AUTH_BYPASS=true playwright test --project=desktop --project=mobile --project=mobile-compact",
    "e2e:smoke": "playwright test e2e/filter-dropdown.certification.spec.mjs --project=desktop --grep smoke",
    "e2e:desktop": "playwright test e2e/filter-dropdown.certification.spec.mjs --project=desktop",
    "e2e:matrix": "playwright test e2e/filter-dropdown.certification.spec.mjs --project=desktop --project=mobile --project=mobile-compact",
    "e2e:certify:filter-dropdown": "pnpm e2e:smoke && pnpm e2e:desktop && pnpm e2e:matrix",
    "e2e:mobile:diagnostic": "playwright test --project=mobile --project=mobile-compact --reporter=line",
    "tests:scope": "node scripts/check-vitest-scope.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format-changed.mjs",
    "duplication:check": "jscpd --config .jscpd.json",
    "classes:check": "node scripts/check-duplicate-classes.mjs",
    "contracts:ownership:check": "node scripts/check-contract-type-ownership.mjs",
    "front:audit": "node scripts/front-audit.mjs",
    "design:contracts:check": "node scripts/validate-design-contract-registry.mjs",
    "design:visual:check": "node scripts/validate-visual-contract-intent.mjs",
    "design:visual:changed": "node scripts/validate-visual-change.mjs",
    "validation:observations": "node scripts/validate-observations.mjs config/validation-observations.example.json",
    "knip": "knip",
    "front:check": "pnpm format:check && pnpm classes:check && pnpm contracts:ownership:check && pnpm certification:source-contracts && pnpm front:audit --fail-on-new-findings --baseline=config/frontend-audit-baseline.json && pnpm duplication:check && pnpm knip --no-exit-code --reporter compact",
    "quality:static:worktree": "node scripts/validate-static-controls.mjs worktree",
    "quality:static:commit": "node scripts/validate-static-controls.mjs commit",
    "quality:static:branch": "node scripts/validate-static-controls.mjs branch",
    "check": "pnpm format:check && pnpm lint && pnpm front:check && pnpm tests:scope && pnpm --filter @loopdev/contracts build && pnpm typecheck && pnpm test",
    "validate:ci": "node scripts/validate-ci.mjs",
    "validate:frontend-ci": "node scripts/validate-frontend-ci.mjs",
    "validate:plan": "node scripts/validate-plan.mjs",
    "validate:worktree": "node scripts/validate-local.mjs worktree",
    "validate:commit": "node scripts/validate-local.mjs commit",
    "validate:branch": "node scripts/validate-local.mjs branch",
    "validate:changed": "node scripts/validate-local.mjs branch",
    "validate:domain": "node scripts/validate-local.mjs domain",
    "validate:experience": "node scripts/validate-local.mjs experience",
    "validate:full": "node scripts/validate-local.mjs full",
    "validate:branch-base": "node scripts/validate-branch-base.mjs",
    "validate:domain-catalog": "node scripts/validate-domain-catalog.mjs",
    "test:domain-catalog": "node --test scripts/validate-domain-catalog.test.mjs",
    "validate:domain-controls": "node scripts/validate-domain-controls.mjs",
    "test:domain-controls": "node --test scripts/validate-domain-controls.test.mjs",
    "validate:protected-surfaces": "node scripts/validate-protected-surface-ownership.mjs",
    "test:protected-surfaces": "node --test scripts/validate-protected-surface-ownership.test.mjs",
    "validate:package-impact": "node scripts/validate-package-impact.mjs",
    "test:package-impact": "node --test scripts/validate-package-impact.test.mjs",
    "validate:track-integrity": "node scripts/validate-track-integrity.mjs",
    "test:track-integrity": "node --test scripts/validate-track-integrity.test.mjs",
    "validate:supabase-governance": "node scripts/validate-supabase-governance.mjs",
    "test:supabase-governance": "node --test scripts/validate-supabase-governance.test.mjs",
    "test:crm:bootstrap": "node scripts/crm-backend-bootstrap.mjs",
    "test:crm:backend-http": "node scripts/test-crm-backend-http.mjs",
    "registries:generate": "node scripts/registries/generate-registry-catalog.mjs",
    "registries:check": "node scripts/registries/generate-registry-catalog.mjs --check",
    "docs:links:check": "node scripts/docs/check-markdown-links.mjs",
    "docs:inventory:generate": "node scripts/docs/generate-documentation-review-inventory.mjs",
    "docs:inventory:check": "node scripts/docs/generate-documentation-review-inventory.mjs --check",
    "validate:git-conventions": "node scripts/validate-git-conventions.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "quality:static": "pnpm front:check",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo clean && rimraf node_modules .turbo ds/node_modules apps/**/node_modules modules/**/node_modules",
    "ds:dev": "pnpm --filter @loopdev/ui dev",
    "ds:build": "pnpm --filter @loopdev/ui build",
    "validate:tokens": "node scripts/validate-tokens-sync.js",
    "component:new": "node scripts/components/create-component.mjs",
    "test:component-generator": "node --test scripts/components/create-component.test.mjs",
    "certification:source-contracts": "node scripts/certification/check-source-contracts.mjs",
    "test:source-contracts": "node --test scripts/certification/check-source-contracts.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "chalk": "4",
    "eslint": "^9.39.2",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.0",
    "tailwindcss": "3.4.17",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
