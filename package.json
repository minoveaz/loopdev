{
  "name": "loopdev-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "start:loopdev": "node scripts/dev/start-loopdev.mjs",
    "start:loopdev:local": "node scripts/dev/start-loopdev.mjs --with-supabase",
    "start:loopdev:ui": "node scripts/dev/start-loopdev.mjs --with-storybook",
    "start:loopdev:full": "node scripts/dev/start-loopdev.mjs --with-supabase --with-storybook",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo clean && rimraf node_modules .turbo ds/node_modules apps/**/node_modules modules/**/node_modules",
    "ds:dev": "pnpm --filter @loopdev/ui dev",
    "ds:build": "pnpm --filter @loopdev/ui build",
    "validate:tokens": "node scripts/validate-tokens-sync.js"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@eslint/js": "^9.39.2",
    "chalk": "4",
    "eslint": "^9.39.2",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.50.1",
    "@vitest/coverage-v8": "4.0.16",
    "vitest": "^4.0.16"
  }
}
