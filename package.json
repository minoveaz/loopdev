{
  "name": "loopdev-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "start:loopdev": "node scripts/dev/start-loopdev.mjs",
    "start:loopdev:local": "node scripts/dev/start-loopdev.mjs --with-supabase",
    "start:loopdev:full": "node scripts/dev/start-loopdev.mjs --with-supabase",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "tests:scope": "node scripts/check-vitest-scope.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format-changed.mjs",
    "duplication:check": "jscpd --config .jscpd.json",
    "classes:check": "node scripts/check-duplicate-classes.mjs",
    "contracts:ownership:check": "node scripts/check-contract-type-ownership.mjs",
    "front:audit": "node scripts/front-audit.mjs",
    "knip": "knip",
    "front:check": "pnpm format:check && pnpm classes:check && pnpm contracts:ownership:check && pnpm front:audit --fail-on-new-findings --baseline=config/frontend-audit-baseline.json && pnpm duplication:check && pnpm knip --no-exit-code --reporter compact",
    "check": "pnpm format:check && pnpm lint && pnpm front:check && pnpm tests:scope && pnpm --filter @loopdev/contracts build && pnpm typecheck && pnpm test",
    "validate:ci": "node scripts/validate-ci.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "quality:static": "pnpm front:check",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo clean && rimraf node_modules .turbo ds/node_modules apps/**/node_modules modules/**/node_modules",
    "ds:dev": "pnpm --filter @loopdev/ui dev",
    "ds:build": "pnpm --filter @loopdev/ui build",
    "validate:tokens": "node scripts/validate-tokens-sync.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "chalk": "4",
    "eslint": "^9.39.2",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.0",
    "tailwindcss": "3.4.17",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
